[Unit]
Description=Home Cinema local media server
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=cinema
Group=cinema
WorkingDirectory=/opt/home-cinema
ExecStart=/usr/bin/node /opt/home-cinema/apps/server/dist/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/home-cinema/data
[Install]
WantedBy=multi-user.target
